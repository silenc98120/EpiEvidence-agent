# LLM配置信息
LLM_PROVIDER='zai'
LLM_MODEL='glm-5.3-flash'
# ChatOpenAI 使用 API 根地址，不要包含 /chat/completions
LLM_BASE_URL='https://open.bigmodel.cn/api/paas/v4'
LLM_API_KEY='your API key'

LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
# 评测模型配置
EVAL_LLM_PROVIDER='deepseek'
EVAL_LLM_MODEL='deepseek-flash'
EVAL_LLM_BASE_URL='https://api.deepseek.com'
EVAL_LLM_API_KEY='your API key'
EVAL_LLM_TEMPERATURE=0.0
# 离线 Judge 模型配置（与生产 LLM 和评测 LLM 独立）
JUDGE_PROVIDER='deepseek'
JUDGE_MODEL='deepseek-reasoner'
JUDGE_BASE_URL='https://api.deepseek.com'
JUDGE_API_KEY='your API key'

# Embedding 仅用于质量评价前的候选语义排序，必须是实际可用的 embedding 模型，不能填写聊天模型。
# EMBEDDING_API_KEY 和 EMBEDDING_BASE_URL 未配置时分别回退到 LLM_API_KEY、LLM_BASE_URL。
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
BGE_M3_MODEL_PATH="your model path"
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_MAX_CONCURRENCY=1

# PostgreSQL数据库配置信息
DATABASE_URL="postgresql+asyncpg://你的username:你的密码@localhost:5432/epi_evidence_db"
CHECKPOINTS_DATABASE_URL="postgresql://你的username:你的密码@localhost:5432/epi_evidence_checkpoints"

# Langfuse监测配置
LANGFUSE_PUBLIC_KEY=<你的 Public Key>
LANGFUSE_SECRET_KEY=<你的 Secret Key>
LANGFUSE_TRACING_ENVIRONMENT=local
